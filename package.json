{
  "name": "dsh-personal-context",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "个人上下文基础设施：来源 → 队列 → 某个 agent 的某个会话",
  "main": "src/plugin/index.js",
  "exports": {
    ".": "./src/plugin/index.js",
    "./client": "./src/plugin/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "deploy",
    "scripts",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./src/plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "daemon": "node src/daemon/index.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "bin": {
    "pc": "./bin/pc.mjs"
  }
}
