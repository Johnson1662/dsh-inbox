# 采集常驻：开机自启，DSH 关着也跑。
# 安装：deploy/install-unit.sh
[Unit]
Description=Personal Context daemon（来源采集 + 队列）
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Development/Personal-Context
EnvironmentFile=%h/.dsh/state/personal-context/sources.env
Environment=PERSONAL_CONTEXT_CONFIG=%h/.dsh/state/personal-context/config.json
# lark-cli 与 node 装在同一处 bin；systemd 的 PATH 里没有，显式补上
Environment=PATH=@NODE_BIN@:/usr/local/bin:/usr/bin:/bin
ExecStart=@NODE@ src/daemon/index.js
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=default.target
