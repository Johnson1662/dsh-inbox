{
  "name": "dsh-inbox-source-wx",
  "version": "0.9.5",
  "type": "module",
  "description": "微信来源：调 wx-cli 读本地聊天库，把新消息写成信封交给守护进程",
  "main": "./index.js",
  "files": [
    "worker.js",
    "index.js",
    "choices.js",
    "package.json"
  ],
  "dsh": {
    "source": {
      "name": "wx",
      "label": "微信",
      "runtime": "node",
      "entry": "worker.js",
      "fields": [
        {
          "key": "enabled",
          "label": "采集微信",
          "type": "boolean",
          "default": false
        },
        {
          "key": "intervalMs",
          "label": "轮询间隔（毫秒）",
          "type": "number",
          "min": 5000,
          "max": 600000,
          "step": 1000,
          "default": 30000
        },
        {
          "key": "chats",
          "label": "采集哪些会话",
          "type": "list",
          "placeholder": "46345148370@chatroom, wxid_xxx",
          "default": "",
          "options": {
            "script": "choices.js",
            "path": "sessions",
            "value": "username",
            "label": "chat",
            "group": {
              "field": "is_group",
              "true": "群聊",
              "false": "联系人",
              "order": [
                "群聊",
                "联系人"
              ]
            }
          }
        }
      ]
    }
  },
  "license": "MIT"
}
