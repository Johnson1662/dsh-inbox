{
  "name": "dsh-personal-context-source-wx",
  "version": "0.7.10",
  "type": "module",
  "description": "微信来源：调 wx-cli 读本地聊天库，把新消息写成信封交给守护进程",
  "main": "./index.js",
  "files": [
    "worker.js",
    "index.js",
    "package.json"
  ],
  "dsh": {
    "source": {
      "name": "wx",
      "label": "微信",
      "runtime": "node",
      "entry": "worker.js",
      "fields": [
        {
          "key": "enabled",
          "label": "采集微信",
          "type": "boolean",
          "default": false
        },
        {
          "key": "intervalMs",
          "label": "轮询间隔（毫秒）",
          "type": "number",
          "min": 5000,
          "max": 600000,
          "step": 1000,
          "default": 30000
        }
      ]
    }
  },
  "license": "MIT"
}
