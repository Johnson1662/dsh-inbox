{
  "name": "dsh-inbox-source-telegram",
  "version": "0.9.5",
  "type": "module",
  "description": "Telegram 来源：轮询会话，把新消息写成信封交给守护进程",
  "main": "./index.js",
  "files": [
    "worker.py",
    "index.js",
    "package.json"
  ],
  "dsh": {
    "source": {
      "name": "telegram",
      "label": "Telegram",
      "runtime": "python",
      "entry": "worker.py",
      "fields": [
        {
          "key": "enabled",
          "label": "采集 Telegram",
          "type": "boolean",
          "default": false
        },
        {
          "key": "intervalMs",
          "label": "轮询间隔（毫秒）",
          "type": "number",
          "min": 1000,
          "max": 300000,
          "step": 500,
          "default": 8000
        }
      ]
    }
  },
  "license": "MIT"
}
