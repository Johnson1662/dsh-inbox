{
  "name": "dsh-inbox-core",
  "version": "0.9.8",
  "type": "module",
  "description": "个人上下文核心：队列、投递适配器、设置面板、命令行",
  "main": "./src/plugin/index.js",
  "exports": {
    ".": "./src/plugin/index.js",
    "./client": "./src/plugin/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "personal-context": "./bin/personal-context.mjs"
  },
  "files": [
    "src",
    "bin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./src/plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "license": "MIT"
}
